# Copy this file to .env.local for local development.
# Find these values in Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=invitation-media

# Used to build the invitation link returned after deployment.
PUBLIC_SITE_URL=https://www.paperless-invites.com

# Temporary dashboard protection. The browser uses its native password prompt;
# no public login page or database-backed admin account is created.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
